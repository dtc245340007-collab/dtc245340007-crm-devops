      "id": 3,
      "title": "CPU Usage % theo từng Container",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{name=~\"crm-.*\"}[1m]) * 100",
          "legendFormat": "{{name}}",
          "refId": "A"
