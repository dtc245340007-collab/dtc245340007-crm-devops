        },
        {
          "expr": "rate(pg_stat_database_blks_read{datname=\"crm\"}[1m])",
          "legendFormat": "Blocks Read/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line" },
          "unit": "ops"
        }
      }
    }
