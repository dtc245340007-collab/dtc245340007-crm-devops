# PostgreSQL Configuration
POSTGRES_DB=crm
POSTGRES_USER=crm_admin
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Dedicated Application DB Role (Non-superuser)
APP_DB_USER=crm_app
APP_DB_PASSWORD=your_secure_app_password_here

# Flask App Configuration
SECRET_KEY=your_secure_secret_key_here
FLASK_ENV=production

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=dtc245340007@gmail.com
PGADMIN_DEFAULT_PASSWORD=your_secure_pgadmin_password_here

# Initial CRM User Passwords
ADMIN_PASSWORD=your_secure_admin_password
STAFF1_PASSWORD=your_secure_staff1_password
STAFF2_PASSWORD=your_secure_staff2_password

# Grafana Configuration
